# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# DocumentCloud has no API token to copy out of the UI. Its API takes your
# MuckRock login and returns a JWT that expires in five minutes, so the
# password itself has to be here — there is no longer-lived credential to
# store instead. Treat this file as you would any password store.

DOCUMENTCLOUD_USER=you@example.com
DOCUMENTCLOUD_PASS=

# Optional. Caps the API calls a single dc_sample.sh run may make, so a bad
# query cannot burn the quota. Enumeration is one call per 100 documents and
# is cached after the first run; downloads come from S3 and cost nothing.
DC_MAX_API_CALLS=80
